# Copy these into Railway → your bot service → Variables.
# Never commit a real .env file with live values to git.

# ── Deriv API (required) ────────────────────────────────────────────────
# app_id from a NEW app registered at https://developers.deriv.com
# (legacy app_ids, e.g. the old demo id 1089, do NOT work with the new
# Options API this bot uses).
DERIV_APP_ID=
# Personal API token for the account you want the bot to trade on.
DERIV_API_TOKEN=
# "demo" (default/safe) or "real". Explicit on purpose — the bot will not
# guess, and prints a loud warning banner on startup if set to "real".
DERIV_ACCOUNT_TYPE=demo
# Optional — skip the accounts lookup and use this account_id directly.
DERIV_ACCOUNT_ID=

# ── Supabase persistence (required — Railway has no persistent filesystem) ─
# Project Settings → API. Use the service_role key, not the anon key —
# this bot both reads AND writes several tables (see the SQL block in the
# module docstring of risefall_bot_v4_hmm_gbm.py; run it once before first
# deploy, including the bot_risefall_lstm_model table used by Gate 6).
SUPABASE_URL=
SUPABASE_KEY=

# ── v10: RISEFALL LSTM ensemble (Gate 6) — minutes only, all optional ───
# Master kill switch. Set to "false" to disable the LSTM standalone path
# entirely (the minute-native Gates 1-6 pipeline still runs either way).
LSTM_ENABLED=true
# Ensemble p_std (epistemic disagreement) above which an LSTM candidate is
# dropped from consideration entirely, regardless of edge.
LSTM_MAX_UNCERTAINTY=0.18
# Minimum |p-0.5| edge for the LSTM ensemble to originate a trade entirely
# on its own, when the minute-native Gates 1-6 pipeline doesn't qualify a
# candidate for a symbol that cycle. Only ever considers the ensemble's
# own MINUTE-duration pick -- there is no tick contract path in this bot.
LSTM_MIN_EDGE_STANDALONE=0.12
# How often (seconds) to re-pull the latest state_dicts from Supabase.
# Reload is piggy-backed onto run_calibration(), so this is a floor, not
# a guarantee — it fires on the next calibration cycle at or after this
# many seconds have elapsed. Default matches the trainer's 2h cron cadence.
LSTM_RELOAD_INTERVAL_SECS=7200
